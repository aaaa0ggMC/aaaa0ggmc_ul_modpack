# Zealous Flesh (Crown material / undead ration)
item.aaaa0ggmc_ul_modpack.zealous_flesh.name=Zealous Flesh
aaaa0ggmc_ul_modpack.zealous_flesh.lore1=§7Always drifting along in tide after tide.
aaaa0ggmc_ul_modpack.zealous_flesh.lore2=§7Dropped when a follower is killed by an iron golem.
aaaa0ggmc_ul_modpack.zealous_flesh.lore3=§7Used to craft the Titan Crown;
aaaa0ggmc_ul_modpack.zealous_flesh.lore4=§7Eating it in undead form restores 10 HP.

# Titan Crown
item.aaaa0ggmc_ul_modpack.titan_crown.name=Titan Crown
aaaa0ggmc_ul_modpack.titan_crown.lore1=§7A crown forged from Zealous Flesh and Gold Ingots.
aaaa0ggmc_ul_modpack.titan_crown.lore2=§7Wear in undead form (requires Horde Leadership & 1 cleared tide) to become a Titan;
aaaa0ggmc_ul_modpack.titan_crown.lore3=§7Take it off to revert. Smart Scale / Human Model bypasses the 12-block headroom check.

